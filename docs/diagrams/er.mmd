erDiagram
  USER ||--o{ EMAIL_VERIFICATION_TOKEN : "verifies with"
  USER ||--o{ PASSWORD_RESET_TOKEN : "resets with"
  USER ||--o{ SESSION : "logs in as"
  USER ||--o{ MFA_BACKUP_CODE : "has (two-step login)"
  USER ||--o| PHONE_VERIFICATION : "checks a number with"
  USER ||--o{ AI_SCAN_COUNT : "counts scans per day"
  USER ||--o{ BILL : owns
  USER |o--o{ PARTICIPANT : "joins as (guests have none)"
  USER ||--o{ EXPENSE : logs
  USER ||--o{ MERCHANT_CATEGORY : remembers
  BILL ||--o{ ITEM : contains
  BILL ||--o{ PARTICIPANT : has
  BILL ||--o{ PAYMENT : "is paid by"
  BILL |o--o{ EXPENSE : "becomes (BILL_SHARE)"
  BILL |o--o{ RECEIPT_IMAGE : "read from"
  ITEM ||--o{ CLAIM : "claimed in"
  PARTICIPANT ||--o{ CLAIM : makes
  PARTICIPANT ||--o| PAYMENT : "pays once"
  EXPENSE |o--o{ RECEIPT_IMAGE : "scanned from"

  USER {
    string id PK
    string email UK
    datetime emailVerifiedAt "null until verified"
    string passwordHash "scrypt"
    boolean hasPassword "false: made with Google"
    string googleId UK "Google's id for the account"
    string displayName
    string phone "unused"
    datetime phoneVerifiedAt "null until checked"
    string paynowMobile "for the PayNow QR"
    string paynowQrPayload "unused"
    string paynowQrImagePath "unused"
    int sessionVersion "raised to end every login"
    string mfaSecret "encrypted; two-step login"
    datetime mfaEnabledAt "null: two-step login off"
    datetime deletedAt "set on delete; wiped 6 months later"
  }
  EMAIL_VERIFICATION_TOKEN {
    string id PK
    string userId FK
    string tokenHash UK "SHA-256, not the token"
    datetime expiresAt
    datetime usedAt "null until used"
  }
  BILL {
    string id PK
    string ownerId FK
    string title
    string merchant
    date date
    int serviceBp "1000 = 10%"
    int gstBp "900 = 9%"
    string shareToken UK
    string joinCode UK "5 characters"
    BillStatus status "OPEN, LOCKED, SETTLED"
  }
  ITEM {
    string id PK
    string billId FK
    string name
    int unitPriceCents
    int quantity
    SplitMode splitMode "EQUAL, PERCENT, SHARES, EXACT"
  }
  PARTICIPANT {
    string id PK
    string billId FK
    string displayName
    string userId FK "null for guests"
  }
  CLAIM {
    string id PK
    string itemId FK
    string participantId FK
    int shares "default 1"
    int percentBp "PERCENT mode"
    int exactCents "EXACT mode"
  }
  PAYMENT {
    string id PK
    string billId FK
    string participantId FK,UK
    int amountCents
    datetime paidAt "null until paid"
  }
  RECEIPT_IMAGE {
    string id PK
    string billId FK "or"
    string expenseId FK "or"
    string storagePath "null: photo not kept"
    string ocrProvider "gemini or fake"
    json rawJson
  }
  EXPENSE {
    string id PK
    string userId FK
    int amountCents
    Category category
    string merchant
    string note
    datetime spentAt
    ExpenseSource source "BILL_SHARE, MANUAL, RECEIPT"
    string billId FK "BILL_SHARE only"
  }
  MERCHANT_CATEGORY {
    string id PK
    string userId FK
    string merchantKey
    Category category "the user's correction"
  }
  PASSWORD_RESET_TOKEN {
    string id PK
    string userId FK
    string tokenHash UK "SHA-256, not the token"
    datetime expiresAt "30 minutes"
    datetime usedAt "null until used"
  }
  SESSION {
    string id PK
    string userId FK
    datetime expiresAt "14 days"
    datetime revokedAt "set by logout"
  }
  MFA_BACKUP_CODE {
    string id PK
    string userId FK
    string codeHash UK
    datetime usedAt "works once"
  }
  PHONE_VERIFICATION {
    string userId PK,FK
    string phone "+65 and 8 digits"
    string codeHash "SMS code, hashed"
    int attempts "5 wrong and it is used up"
    string linkHash UK "Telegram link, hashed"
    datetime expiresAt
  }
  AI_SCAN_COUNT {
    string userId PK,FK
    date day PK "Singapore date"
    int count "capped per day"
  }
