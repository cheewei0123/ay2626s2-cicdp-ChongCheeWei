# The production web server (Caddy), baked into the splitlah-web image.
# - HTTPS for the site: Caddy gets a free Let's Encrypt certificate and renews it by itself.
#   Plain http:// is redirected to https:// automatically.
# - /api/* goes to the API container; everything else is the React app.
# SITE_ADDRESS lets a local test use ":80" (plain HTTP, no certificate).
{$SITE_ADDRESS:splitlah.duckdns.org} {
	encode zstd gzip

	# Security headers on every response (KAN-96, see docs/security.md)
	header {
		# Only ever HTTPS from now on: the browser won't try http:// for a year
		Strict-Transport-Security "max-age=31536000"
		# Scripts, styles and frames only from us, plus Google's sign-in button (KAN-95).
		# No inline scripts, so an injected <script> can't run. frame-ancestors: no other
		# site can put SplitLah in a frame (clickjacking).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY" # the same as frame-ancestors, for older browsers
		X-Content-Type-Options "nosniff"
		# Other sites see only our origin, never a path such as /share/<token>
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server # don't advertise the web server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		# Every file except the hashed ones in /assets is checked with the server before use
		# (no-cache), so a phone never keeps an old index.html or service worker after a deploy.
		# /assets/* names change with every build, so those can be cached as usual.
		@notHashed not path /assets/*
		header @notHashed Cache-Control "no-cache"
		root * /srv
		# A single-page app: a path like /bills/abc has no file, so serve the app and let React route it
		try_files {path} /index.html
		file_server
	}
}
