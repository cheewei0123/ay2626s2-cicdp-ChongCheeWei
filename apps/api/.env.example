PORT=3000
# Local Docker database from infra/docker-compose.dev.yml (not a real secret)
DATABASE_URL="postgresql://splitlah:splitlah@localhost:5433/splitlah?schema=public"
# Only this origin may call the API from a browser (CORS)
WEB_ORIGIN=http://localhost:5173
# Signs login tokens: use a long random string, at least 32 characters
JWT_SECRET=
# Which receipt reader to use: fake (no network, used in tests and CI) or gemini
OCR_PROVIDER=fake
# Only needed when OCR_PROVIDER=gemini. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Most AI receipt scans one account can make per Singapore day (default 20)
AI_DAILY_LIMIT=20
# Who sends the verify-your-email link: fake (logs the link, used in tests and CI) or smtp
EMAIL_PROVIDER=fake
# Only needed when EMAIL_PROVIDER=smtp. Gmail: your address and a Google app password
# (Google Account > Security > App passwords), never your normal password.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (465), EMAIL_FROM
# Where the link in the email points; required with smtp
APP_URL=http://localhost:5173
# Who texts the code that checks a PayNow number (KAN-91): fake (logs the code, used in
# tests and CI) or sns (Amazon SNS through the EC2 instance's IAM role, so no key here)
SMS_PROVIDER=fake
# Only needed when SMS_PROVIDER=sns
AWS_REGION=ap-southeast-1
# The Telegram bot that checks PayNow numbers for free (KAN-91). Leave all three empty
# to turn it off. Token and name come from @BotFather; the secret is any 16+ random
# letters/digits (e.g. openssl rand -hex 32). Needs an https APP_URL for the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# "Continue with Google" (KAN-95). The OAuth client ID from Google Cloud Console
# (ends in .apps.googleusercontent.com). It is public (the browser sees it), so it is
# not a secret. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
