PORT=3000
# Local Docker database from infra/docker-compose.dev.yml (not a real secret)
DATABASE_URL="postgresql://splitlah:splitlah@localhost:5433/splitlah?schema=public"
# Only this origin may call the API from a browser (CORS)
WEB_ORIGIN=http://localhost:5173
# Signs login tokens: use a long random string, at least 32 characters
JWT_SECRET=
# Which receipt reader to use: fake (no network, used in tests and CI) or gemini
OCR_PROVIDER=fake
# Only needed when OCR_PROVIDER=gemini. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
