// Built from docs/data-model.md. Money is Int cents, rates are Int basis points.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BillStatus {
  OPEN
  LOCKED
  SETTLED
}

enum SplitMode {
  EQUAL
  PERCENT
  SHARES
  EXACT
}

enum ExpenseSource {
  BILL_SHARE
  MANUAL
  RECEIPT
}

enum Category {
  FOOD_DRINKS
  GROCERIES
  TRANSPORT
  SHOPPING
  GIFTS
  ENTERTAINMENT
  BILLS_UTILITIES
  HEALTH
  TRAVEL
  OTHERS
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerifiedAt   DateTime?
  passwordHash      String
  displayName       String
  phone             String?
  // When paynowMobile was proved by an SMS code (KAN-91); null = not checked, so no PayNow QR
  phoneVerifiedAt   DateTime?
  paynowMobile      String?
  paynowQrPayload   String?
  paynowQrImagePath String?
  // Goes up by one when the password changes; login tokens carry it, so older tokens stop working (KAN-90)
  sessionVersion    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  bills               Bill[]
  participants        Participant[]
  expenses            Expense[]
  merchantCategories  MerchantCategory[]
  aiScanCounts        AiScanCount[]
  phoneVerification   PhoneVerification?
}

// A one-time "reset your password" link (KAN-90). Only the hash is stored, like email verification.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bill {
  id         String     @id @default(cuid())
  ownerId    String
  title      String
  merchant   String
  date       DateTime   @db.Date
  serviceBp  Int        @default(1000)
  gstBp      Int        @default(900)
  shareToken String     @unique
  // Short code friends can type instead of opening the link, e.g. K7P2Q.
  // Optional so the migration only adds a column (bills made before it have none).
  joinCode   String?    @unique
  status     BillStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id])
  items         Item[]
  participants  Participant[]
  payments      Payment[]
  receiptImages ReceiptImage[]
  expenses      Expense[]

  @@index([ownerId])
}

model Item {
  id             String    @id @default(cuid())
  billId         String
  name           String
  unitPriceCents Int
  quantity       Int       @default(1)
  splitMode      SplitMode @default(EQUAL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bill   Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  claims Claim[]

  @@index([billId])
}

model Participant {
  id          String   @id @default(cuid())
  billId      String
  displayName String
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  claims  Claim[]
  payment Payment?
}

model Claim {
  id            String   @id @default(cuid())
  itemId        String
  participantId String
  shares        Int      @default(1)
  percentBp     Int?
  exactCents    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([itemId, participantId])
  @@index([itemId])
}

model Payment {
  id            String    @id @default(cuid())
  billId        String
  participantId String    @unique
  amountCents   Int
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bill        Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([billId, participantId])
}

model ReceiptImage {
  id          String   @id @default(cuid())
  billId      String?
  expenseId   String?
  storagePath String? // null: the photo itself is not kept, only what was read from it
  ocrProvider String
  rawJson     Json
  createdAt   DateTime @default(now())

  bill    Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String        @id @default(cuid())
  userId      String
  amountCents Int
  category    Category
  merchant    String?
  note        String?
  spentAt     DateTime
  source      ExpenseSource
  billId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  bill          Bill?          @relation(fields: [billId], references: [id], onDelete: Cascade)
  receiptImages ReceiptImage[]

  @@unique([userId, billId])
  @@index([userId, spentAt])
}

model MerchantCategory {
  id          String   @id @default(cuid())
  userId      String
  merchantKey String
  category    Category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, merchantKey])
}

// How many AI receipt scans a user made on one Singapore day (KAN-88).
// Gemini usage costs quota, so each account gets a daily cap (AI_DAILY_LIMIT).
model AiScanCount {
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// A number waiting for its SMS code (KAN-91). One per user: asking again replaces it.
// The verified number only moves into User.paynowMobile once the code is right,
// so the old number keeps working until then.
// A number waiting to be checked, either by an SMS code or through Telegram (KAN-91)
model PhoneVerification {
  userId         String   @id
  phone          String // +65 and 8 digits
  codeHash       String? // SMS: SHA-256 of the 6-digit code; the code itself is never stored
  attempts       Int      @default(0) // wrong codes so far; 5 and the code is used up
  linkHash       String?  @unique // Telegram: SHA-256 of the token in the t.me link
  telegramUserId String?  @unique // Telegram: the account that opened the link
  expiresAt      DateTime
  createdAt      DateTime @default(now()) // also when the last SMS went out, for the 60 s wait
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
