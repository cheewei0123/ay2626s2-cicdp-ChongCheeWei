# Keeps the Docker build context small and secret-free.
# Anything listed here can never be COPY'd into an image.

# Installed or built inside the image instead
**/node_modules
**/dist
**/coverage
apps/api/src/generated

# Secrets: real values are passed in at run time, never baked into the image
**/.env
**/.env.*
!**/.env.example

# Not needed to run the app
.git
.github
docs
infra
**/test
**/*.spec.ts
**/*.log
